{
  "plugins": ["simple-import-sort"],
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "env": {
    "es6": true,
    "node": true
  },
  "extends": [
    "next/core-web-vitals",
    "prettier",
    "plugin:prettier/recommended"
  ],
  "rules": {
    "@next/next/no-img-element": "off",
    "prettier/prettier": [
      "error",
      {
        "singleQuote": true,
        "semi": false
      }
    ],
    "simple-import-sort/imports": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          "./", "../", "~/"
        ]
      }
    ]
  }
}